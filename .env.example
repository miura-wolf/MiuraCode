# =====================================================================
# Atomic AI — configuración de ejemplo (NO contiene secretos reales).
# Copia este archivo a `.env` y ajusta los valores a tu entorno.
# El archivo `.env` NO debe versionarse (ver .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# Upstream (servidor OpenAI-compatible, p. ej. llama.cpp en local)
# ---------------------------------------------------------------------
# llama.cpp local: apunta al puerto de llama-server (ver llama_cpp.bat).
UPSTREAM_BASE_URL=http://127.0.0.1:8080
# En local (llama-server sin --api-key) se deja vacío.
UPSTREAM_API_KEY=
# Nombre del modelo que reenvía el proxy por defecto. Si el cliente envía
# el campo "model" en cada request, prima ese valor. llama-server usa el
# modelo que tenga cargado según su preset (este campo es informativo).
UPSTREAM_MODEL=Qwen3.5-4B

# ---------------------------------------------------------------------
# Descomposición atómica
# ---------------------------------------------------------------------
# Profundidad máxima del árbol de subtareas. Para modelos locales pequeños
# empieza en 1 (menos llamadas/secuencia). Súbelo cuando notes estabilidad.
MAX_DECOMPOSITION_DEPTH=1
MAX_TOOL_ROUNDS_PER_PHASE=25

# ---------------------------------------------------------------------
# Proxy (dónde escucha este servidor)
# ---------------------------------------------------------------------
PROXY_HOST=127.0.0.1
PROXY_PORT=8120

# Tiempo máximo (segundos) para una request al upstream. Con inferencia
# local en CPU/GPU modesta, sube el margen (p. ej. 900).
REQUEST_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=200

# ---------------------------------------------------------------------
# Salida
# ---------------------------------------------------------------------
# Expone el razonamiento interno (reasoning_content) del proxy.
EXPOSE_REASONING_CONTENT=true

# ---------------------------------------------------------------------
# Base de conocimiento / RAG híbrido
# ---------------------------------------------------------------------
# Ruta de la base SQLite (conocimiento + sesiones).
DATABASE_PATH=atomic_ai.db

# Servidor de embeddings local (OpenAI-compatible /v1/embeddings).
# Vacío = la búsqueda de conocimiento usa solo keywords (FTS5).
# Recomendado: llama-server con bge-m3 en otro puerto (ver llama_embedding.bat).
EMBEDDINGS_BASE_URL=http://127.0.0.1:8081
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_TIMEOUT_SECONDS=30

# Fusión de resultados FTS5 (keywords) + similitud coseno (semántico).
HYBRID_SEARCH=true
HYBRID_CANDIDATES=6

# Auto-aprendizaje: guarda resultados exitosos de hojas/síntesis en la base
# de conocimiento para reutilizarlos en tareas futuras similares.
AUTO_LEARN_KNOWLEDGE=true

# Protección opcional de los endpoints admin (/v1/knowledge*). Vacío = sin
# token extra (confía en que el proxy solo escucha en localhost).
ADMIN_TOKEN=

# ---------------------------------------------------------------------
# F1 — Routing multi-modelo por especialidad
# ---------------------------------------------------------------------
# Cuando SPECIALTY_ROUTING=true, el motor asigna un modelo distinto a cada
# hoja atómica según su especialidad detectada (visión, código, resumen
# rápido), en lugar de usar un único modelo para todo el turno. La
# descomposición (planificar) siempre usa el modelo base, y el modelo base
# del turno tampoco cambia. Cada modelo de especialidad vacío = usa el
# modelo base del turno (degrada con elegancia si solo hay un modelo).
SPECIALTY_ROUTING=false
# Modelo para hojas que requieren visión (solo si el turno trae imágenes).
VISION_MODEL=
# Modelo para hojas de código/programación.
CODE_MODEL=
# Modelo rápido para hojas de resumen/traducción/listados breves.
FAST_MODEL=
# Modelo para la síntesis final. Vacío = modelo base del turno.
SYNTHESIS_MODEL=

# ---------------------------------------------------------------------
# F2 — Resiliencia: reintentos y fallback
# ---------------------------------------------------------------------
# Cuántos reintentos de transporte hacer ante un error transitorio (timeout,
# conexión, 5xx, 429). 0 = sin reintentos. Los 4xx no transitorios (auth, bad
# request, modelo no encontrado) nunca se reintentan.
UPSTREAM_MAX_RETRIES=2
# Espera base entre reintentos (segundos); el backoff es lineal (base * intento).
UPSTREAM_RETRY_BACKOFF_SECONDS=0.5
# Modelo de respaldo: si está configurado, los reintentos (intento > 0) usan
# este modelo en vez del original. Vacío = reintentar con el mismo modelo.
FALLBACK_MODEL=

# ---------------------------------------------------------------------
# F3 — Ejecución paralela de hojas
# ---------------------------------------------------------------------
# Si está activo y no hay tools activas, las hojas atómicas independientes se
# ejecutan en paralelo (asyncio.gather) en vez de secuencialmente, dando un
# speedup real en tareas con varias subtareas sueltas. Asume que las subtareas
# no dependen unas de otras. Con tools activas se vuelve automáticamente al
# modo secuencial (la pausa/reanudación de tool_calls es secuencial).
PARALLEL_LEAVES=false
